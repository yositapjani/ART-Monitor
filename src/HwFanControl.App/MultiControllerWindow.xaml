<Window x:Class="HwFanControl.App.MultiControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multiple Controllers" Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Hingga 4 controller independen. PWM fisik = nilai tertinggi dari yang aktif."/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Batal" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Simpan" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
    <ItemsControl x:Name="ControllerList"/>
  </DockPanel>
</Window>
