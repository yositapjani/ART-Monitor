    private readonly System.Collections.ObjectModel.ObservableCollection<OverviewLegendUi> _legendCpu = new();
    private readonly System.Collections.ObjectModel.ObservableCollection<OverviewLegendUi> _legendGpu = new();
    private readonly System.Collections.ObjectModel.ObservableCollection<OverviewLegendUi> _legendDisk = new();
    private readonly System.Collections.ObjectModel.ObservableCollection<OverviewLegendUi> _legendNet = new();

    private static string SectionOf(string seriesName) =>
        OverviewViewModel.GroupOf(seriesName) switch
        {
            "gpu" => "gpu",
            "net" => "net",
            "disk" => "disk",
            _ => "cpu",
        };

    private void SyncLegendSections()
    {
        DistributeLegend(_legendCpu, "cpu");
        DistributeLegend(_legendGpu, "gpu");
        DistributeLegend(_legendDisk, "disk");
        DistributeLegend(_legendNet, "net");
    }

    private void DistributeLegend(System.Collections.ObjectModel.ObservableCollection<OverviewLegendUi> target, string section)
    {
        var src = _service.Overview.Legend;
        int desired = 0;
        foreach (var item in src)
            if (SectionOf(item.Name) == section)
                desired++;

        bool same = target.Count == desired;
        if (same)
        {
            int j = 0;
            foreach (var item in src)
            {
                if (SectionOf(item.Name) != section)
                    continue;
                if (!ReferenceEquals(target[j], item))
                {
                    same = false;
                    break;
                }

                j++;
            }
        }

        if (same)
            return;

        target.Clear();
        foreach (var item in src)
            if (SectionOf(item.Name) == section)
                target.Add(item);
    }

    private int _quickTick;
    private string _quickIp = "-";

    private void UpdateQuickInfo()
    {
        var now = DateTime.Now;
        QuickClock.Text = now.ToString("HH:mm:ss");
        QuickDate.Text = now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"));
        var up = TimeSpan.FromMilliseconds(Environment.TickCount64);
        QuickUptime.Text = up.Days > 0
            ? $"{up.Days} hari {up.Hours} jam {up.Minutes} menit"
            : $"{up.Hours} jam {up.Minutes} menit";

        if (_quickTick++ % 30 == 0)
        {
            try
            {
                foreach (var ni in System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces())
                {
                    if (ni.OperationalStatus != System.Net.NetworkInformation.OperationalStatus.Up)
                        continue;
                    if (ni.NetworkInterfaceType == System.Net.NetworkInformation.NetworkInterfaceType.Loopback)
                        continue;
                    string? found = null;
                    foreach (var ua in ni.GetIPProperties().UnicastAddresses)
                    {
                        if (ua.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork)
                        {
                            found = ua.Address.ToString();
                            break;
                        }
                    }

                    if (found is not null)
                    {
                        _quickIp = found;
                        break;
                    }
                }
            }
            catch
            {
                // IP display is best-effort.
            }
        }

        QuickIp.Text = _quickIp;
        QuickNetDown.Text = _service.Overview.SessionDownText;
        QuickNetUp.Text = _service.Overview.SessionUpText;
    }

    private void ApplyLocalization()
    {
        var loc = LocalizationService.Instance;
        Title = $"{AppVersion.ProductName} {AppVersion.Display}";
        MenuFile.Header = loc.T("Menu.File");
        MenuSaveProfile.Header = loc.T("Menu.SaveProfile");
        MenuExit.Header = loc.T("Menu.Exit");
        MenuOptions.Header = loc.T("Menu.Options");
        MenuApplyStartup.Header = loc.T("Menu.ApplyStartup");
        MenuSettings.Header = loc.T("Menu.Settings");
        MenuLanguage.Header = loc.T("Menu.Language");
        MenuLangEn.Header = loc.T("Lang.English");
        MenuLangId.Header = loc.T("Lang.Indonesian");
        MenuLangEn.IsChecked = loc.IsEnglish;
        MenuLangId.IsChecked = loc.IsIndonesian;
        MenuTools.Header = loc.T("Menu.Tools");
        MenuPawnIo.Header = loc.T("Menu.PawnIO");
        MenuRestoreBios.Header = loc.T("Menu.RestoreBios");
        MenuHelp.Header = loc.T("Menu.Help");
        MenuAbout.Header = loc.T("Menu.About");
        FanTempsGroup.Header = loc.T("Fan.Temps");
        ApplyStartupGlobal.Content = loc.T("Fan.ApplyStartup");
        UpdateBanner();
        RefreshStatus();
        if (_tray is not null)
        {
            _tray.Text = AppVersion.ProductName;
            RebuildTrayMenu();
        }
    }

