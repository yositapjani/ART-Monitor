        ThemeService.SetDark(ThemeSelector.SelectedIndex == 1, this);
    }

    private readonly System.Collections.Generic.Dictionary<string, (Border Item, Controls.MiniGraphCanvas Canvas, TextBlock Value)> _miniGraphs = new();

    private void SyncMiniGraphs()
    {
        var vm = _service.Overview;
        var series = new System.Collections.Generic.List<MiniSeries>();
        for (int li = 0; li < vm.Legend.Count; li++)
        {
            var entry = vm.Legend[li];
            if (!entry.IsVisible)
                continue;
            string key = entry.Name;
            int idx = li;
            series.Add(new MiniSeries
            {
                Key = key,
                Title = entry.Name,
                ValueText = entry.ValueText,
                Color = vm.ColorForIndex(idx),
                Data = () => vm.Histories.TryGetValue(key, out var q) ? q.ToArray() : System.Array.Empty<float>(),
                Capacity = OverviewViewModel.HistoryCapacity,
            });
        }

        SyncTiles(MiniGraphPanel, _miniGraphs, series);
    }

    private (Border, Controls.MiniGraphCanvas, TextBlock) CreateMiniGraphItem(string titleText, System.Windows.Media.Color color)
    {
        var headerBrush = new System.Windows.Media.SolidColorBrush(Darken(color, 0.55));
        var title = new TextBlock
        {
            Text = titleText,
            Foreground = System.Windows.Media.Brushes.White,
            FontWeight = System.Windows.FontWeights.SemiBold,
            FontSize = 11,
            VerticalAlignment = System.Windows.VerticalAlignment.Center,
            TextTrimming = System.Windows.TextTrimming.CharacterEllipsis,
        };
        var value = new TextBlock
        {
            Text = "-",
            Foreground = System.Windows.Media.Brushes.White,
            FontWeight = System.Windows.FontWeights.SemiBold,
            FontSize = 11,
            VerticalAlignment = System.Windows.VerticalAlignment.Center,
        };
        var headerGrid = new System.Windows.Controls.Grid();
        headerGrid.ColumnDefinitions.Add(new System.Windows.Controls.ColumnDefinition { Width = new System.Windows.GridLength(1, System.Windows.GridUnitType.Star) });
        headerGrid.ColumnDefinitions.Add(new System.Windows.Controls.ColumnDefinition { Width = System.Windows.GridLength.Auto });
        headerGrid.Children.Add(title);
        System.Windows.Controls.Grid.SetColumn(value, 1);
        headerGrid.Children.Add(value);
        var header = new Border
        {
            Background = headerBrush,
            Padding = new System.Windows.Thickness(6, 2, 6, 2),
            Child = headerGrid,
        };
        var canvas = new Controls.MiniGraphCanvas();
        var dock = new System.Windows.Controls.DockPanel();
        System.Windows.Controls.DockPanel.SetDock(header, System.Windows.Controls.Dock.Top);
        dock.Children.Add(header);
        dock.Children.Add(canvas);
        var item = new Border
        {
            Width = 258,
            Height = 116,
            Margin = new System.Windows.Thickness(3),
            BorderBrush = System.Windows.Media.Brushes.Black,
            BorderThickness = new System.Windows.Thickness(1),
            Child = dock,
        };
        return (item, canvas, value);
    }

    private static System.Windows.Media.Color Darken(System.Windows.Media.Color c, double f) =>
        System.Windows.Media.Color.FromRgb((byte)(c.R * f), (byte)(c.G * f), (byte)(c.B * f));

    private sealed class MiniSeries
    {
        public string Key = "";
        public string Title = "";
        public string ValueText = "-";
        public System.Windows.Media.Color Color;
        public System.Func<System.Collections.Generic.IReadOnlyList<float>> Data = () => System.Array.Empty<float>();
        public int Capacity = 180;
    }

    private static (string Title, string Value) SplitLegendText(string text)
    {
        var m = System.Text.RegularExpressions.Regex.Match(
            text ?? "",
            @"^(?<name>.*?)\s+(?<val>-?\d+(?:[.,]\d+)?)\s*(?<unit>\S*)$");
        if (m.Success && m.Groups["name"].Value.Length > 0)
        {
            string unit = m.Groups["unit"].Value;
            return (m.Groups["name"].Value,
                m.Groups["val"].Value + (unit.Length > 0 ? " " + unit : ""));
        }

        return (text ?? "", "-");
    }

    private void SyncTiles(
        System.Windows.Controls.WrapPanel panel,
        System.Collections.Generic.Dictionary<string, (Border Item, Controls.MiniGraphCanvas Canvas, TextBlock Value)> store,
        System.Collections.Generic.List<MiniSeries> series)
    {
        var wanted = new System.Collections.Generic.HashSet<string>();
        for (int i = 0; i < series.Count; i++)
        {
            var s = series[i];
            wanted.Add(s.Key);
            if (!store.TryGetValue(s.Key, out var tile))
            {
                tile = CreateMiniGraphItem(s.Title, s.Color);
                store[s.Key] = tile;
            }

            int idx = panel.Children.IndexOf(tile.Item);
            if (idx != i)
            {
                if (idx >= 0)
                    panel.Children.Remove(tile.Item);
                panel.Children.Insert(i, tile.Item);
            }

            tile.Canvas.Bind(() => new Controls.MiniGraphCanvas.Frame(s.Data(), s.Color, s.Capacity));
            tile.Canvas.Redraw();
            tile.Value.Text = s.ValueText;
        }

        var stale = new System.Collections.Generic.List<string>();
        foreach (var key in store.Keys)
            if (!wanted.Contains(key))
                stale.Add(key);
        foreach (var key in stale)
        {
            panel.Children.Remove(store[key].Item);
            store.Remove(key);
        }

        // Stretch tiles so the graphs fill the available box (no empty gaps).
        double pw = panel.ActualWidth;
        if (pw > 200)
        {
            int cols = Math.Max(1, (int)(pw / 264));
            double tw = (pw - 4) / cols - 6;
            double th = Math.Max(84, tw * 0.45);
            foreach (var tile in store.Values)
            {
                tile.Item.Width = tw;
                tile.Item.Height = th;
            }
        }
    }

    private readonly System.Collections.Generic.Dictionary<string, (Border Item, Controls.MiniGraphCanvas Canvas, TextBlock Value)> _cpuTiles = new();
    private TempGraphModel? _cpuTileModel;

    private void SyncCpuMiniGraphs()
    {
        var model = _activeCpuGraph;
        if (model is null)
            return;
        if (!ReferenceEquals(model, _cpuTileModel))
        {
            _cpuTileModel = model;
            _cpuTiles.Clear();
            CpuMiniPanel.Children.Clear();
        }

        var series = new System.Collections.Generic.List<MiniSeries>
        {
            MakeCpuSeries(model, 0, () => model.GetCoresSeries(), TempGraphModel.CoresColor),
        };
        if (model.HasCcd)
            series.Add(MakeCpuSeries(model, 1, () => model.GetCcdSeries(), TempGraphModel.CcdColor));
        series.Add(MakeCpuSeries(model, model.HasCcd ? 2 : 1, () => model.GetSocketSeries(), TempGraphModel.SocketColor));
        SyncTiles(CpuMiniPanel, _cpuTiles, series);
    }

    private MiniSeries MakeCpuSeries(TempGraphModel model, int legendIndex,
        System.Func<System.Collections.Generic.IReadOnlyList<float>> data, System.Windows.Media.Color color)
    {
        string text = legendIndex < model.Legend.Count ? model.Legend[legendIndex].Text : "";
        var (title, value) = SplitLegendText(text);
        return new MiniSeries
        {
            Key = legendIndex + ":" + title,
            Title = title,
            ValueText = value,
            Color = ThemeService.ForGraph(color),
            Data = data,
            Capacity = TempGraphModel.Capacity,
        };
    }

    private readonly System.Collections.Generic.Dictionary<string, (Border Item, Controls.MiniGraphCanvas Canvas, TextBlock Value)> _gpuTiles = new();
    private readonly System.Collections.Generic.Dictionary<string, (Border Item, Controls.MiniGraphCanvas Canvas, TextBlock Value)> _hdTiles = new();
    private readonly System.Collections.Generic.Dictionary<string, (Border Item, Controls.MiniGraphCanvas Canvas, TextBlock Value)> _mbTiles = new();

    private void SyncGpuMiniGraphs()
    {
        var vm = _service.Gpu;
        var series = new System.Collections.Generic.List<MiniSeries>();
        foreach (var item in vm.Legend)
        {
            string key = item.Key;
            var (title, value) = SplitLegendText(item.Text);
            var color = (item.Brush as System.Windows.Media.SolidColorBrush)?.Color ?? System.Windows.Media.Colors.Gray;
            series.Add(new MiniSeries
            {
                Key = key,
                Title = title,
                ValueText = value,
                Color = ThemeService.ForGraph(color),
                Data = () => vm.Histories.TryGetValue(key, out var q) ? q.ToArray() : System.Array.Empty<float>(),
                Capacity = GpuViewModel.HistoryCapacity,
            });
        }

        SyncTiles(GpuMiniPanel, _gpuTiles, series);
    }

