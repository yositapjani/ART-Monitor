    }

    private void MenuLangId_Click(object sender, RoutedEventArgs e)
    {
        LocalizationService.Instance.Language = AppLanguage.Indonesian;
    }

    /// <summary>Package / socket / max core — whichever is hotter.</summary>
    private float ResolveCpuWarningTemp()
    {
        float max = float.NaN;
        foreach (var row in _service.Temperatures)
        {
            if (row.Source is not (TemperatureSourceKind.CpuPackage or TemperatureSourceKind.CpuCoreMax))
                continue;
            if (!row.HasValue || float.IsNaN(row.ValueCelsius))
                continue;
            max = float.IsNaN(max) ? row.ValueCelsius : Math.Max(max, row.ValueCelsius);
        }

        if (!float.IsNaN(max))
            return max;

        // Fallback from live CPU readings if temp rows are empty.
        float socket = float.NaN;
        float coreMax = float.NaN;
        foreach (var row in _service.CpuInfo.Readings)
        {
            float t = ParseTemp(row.CurrentText);
            if (float.IsNaN(t))
                continue;
            if (row.Label.StartsWith("Core #", StringComparison.OrdinalIgnoreCase))
                coreMax = float.IsNaN(coreMax) ? t : Math.Max(coreMax, t);
            else if (row.Label.Equals("Tdie", StringComparison.OrdinalIgnoreCase) ||
                     row.Label.Contains("Tctl", StringComparison.OrdinalIgnoreCase) ||
                     row.Label.Contains("Package", StringComparison.OrdinalIgnoreCase) ||
                     row.Label.Contains("Socket", StringComparison.OrdinalIgnoreCase))
                socket = t;
        }

        if (float.IsNaN(socket))
            return coreMax;
        if (float.IsNaN(coreMax))
            return socket;
        return Math.Max(socket, coreMax);
    }

    private void UpdateGraphFromCpu()
    {
        var info = _service.CpuInfo;
        _graph.UpdateIdentity(info.Model, info.IsAmd, info.IsIntel);
        _graphSpeed.UpdateIdentity(info.Model, info.IsAmd, info.IsIntel);
        _graphMul.UpdateIdentity(info.Model, info.IsAmd, info.IsIntel);
        _graphPower.UpdateIdentity(info.Model, info.IsAmd, info.IsIntel);
        GraphVendor.Text = _activeCpuGraph.VendorText;
        GraphModel.Text = _activeCpuGraph.ModelText;

        float socket = float.NaN;
        float ccd = float.NaN;
        float coreSum = 0;
        int coreCount = 0;
        foreach (var row in info.Readings)
        {
            if (row.Label.Equals("Tdie", StringComparison.OrdinalIgnoreCase) ||
                row.Label.Contains("Tctl", StringComparison.OrdinalIgnoreCase) ||
                row.Label.Contains("Package", StringComparison.OrdinalIgnoreCase) ||
                row.Label.Contains("Socket", StringComparison.OrdinalIgnoreCase))
            {
                socket = ParseTemp(row.CurrentText);
            }
            else if (row.Label.Contains("CCD", StringComparison.OrdinalIgnoreCase))
            {
                if (float.IsNaN(ccd))
                    ccd = ParseTemp(row.CurrentText);
            }
            else if (row.Label.StartsWith("Core #", StringComparison.OrdinalIgnoreCase))
            {
                float t = ParseTemp(row.CurrentText);
                if (!float.IsNaN(t) && t > 0.01f)
                {
                    coreSum += t;
                    coreCount++;
                }
            }
        }

        // When per-core temps are missing, fall back to socket/Tdie as "CPU Cores".
        float cores = coreCount > 0 ? coreSum / coreCount : socket;
        _graph.Push(cores, ccd, socket);

        // Speed / Multiplier / Power aggregates from the same readings (unit-suffix matched).
        float clkSum = 0, clkMax = float.NaN; int clkN = 0;
        float mulSum = 0, mulMax = float.NaN; int mulN = 0;
        float pkgPow = float.NaN, corePowMax = float.NaN;
        foreach (var row in info.Readings)
        {
            string txt = row.CurrentText;
            float v = ParseValue(txt);
            if (float.IsNaN(v))
                continue;
            bool isCore = row.Label.StartsWith("Core #", StringComparison.OrdinalIgnoreCase);
            if (isCore && txt.Contains("MHz", StringComparison.OrdinalIgnoreCase))
            {
                clkSum += v; clkN++;
                clkMax = float.IsNaN(clkMax) ? v : Math.Max(clkMax, v);
            }
            else if (txt.EndsWith("W", StringComparison.OrdinalIgnoreCase))
            {
                if (row.Label.Equals("Package", StringComparison.OrdinalIgnoreCase))
                    pkgPow = v;
                else if (isCore)
                    corePowMax = float.IsNaN(corePowMax) ? v : Math.Max(corePowMax, v);
            }
            else if (isCore
                     && !txt.Contains("°C", StringComparison.OrdinalIgnoreCase)
                     && !txt.Contains("%", StringComparison.OrdinalIgnoreCase)
                     && !txt.EndsWith("V", StringComparison.OrdinalIgnoreCase)
                     && v >= 4f && v <= 100f)
            {
                mulSum += v; mulN++;
                mulMax = float.IsNaN(mulMax) ? v : Math.Max(mulMax, v);
            }
        }
        _graphSpeed.Push(clkN > 0 ? clkSum / clkN : float.NaN, float.NaN, clkMax);
        _graphMul.Push(mulN > 0 ? mulSum / mulN : float.NaN, float.NaN, mulMax);
        _graphPower.Push(pkgPow, float.NaN, corePowMax);
        TempGraph.Redraw();
    }

    private void GpuFanMode_Changed(object sender, SelectionChangedEventArgs e)
    {
        if (!_service.IsHardwareOpen)
            return;
        _service.SetGpuFanSoftwareControl(GpuFanMode.SelectedIndex == 1);
    }

