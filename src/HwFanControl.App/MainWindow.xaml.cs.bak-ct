        _service.Profile.Logging.Enabled = MenuLogging.IsChecked;
        _service.SaveProfile();
    }

    private void CpuSubTab_Click(object sender, RoutedEventArgs e)
    {
        if (sender is not System.Windows.Controls.Primitives.ToggleButton clicked)
            return;

        CpuSubTemp.IsChecked = ReferenceEquals(clicked, CpuSubTemp);
        CpuSubSpeed.IsChecked = ReferenceEquals(clicked, CpuSubSpeed);
        CpuSubMul.IsChecked = ReferenceEquals(clicked, CpuSubMul);
        CpuSubPower.IsChecked = ReferenceEquals(clicked, CpuSubPower);

        CpuTempView.Visibility = Visibility.Visible;
        CpuPlaceholderView.Visibility = Visibility.Collapsed;

        _activeCpuGraph = clicked switch
        {
            _ when ReferenceEquals(clicked, CpuSubSpeed) => _graphSpeed,
            _ when ReferenceEquals(clicked, CpuSubMul) => _graphMul,
            _ when ReferenceEquals(clicked, CpuSubPower) => _graphPower,
            _ => _graph,
        };
        TempGraph.Bind(_activeCpuGraph);
        CpuTempLegend.ItemsSource = _activeCpuGraph.Legend;
        GraphVendor.Text = _activeCpuGraph.VendorText;
        GraphModel.Text = _activeCpuGraph.ModelText;
    }

    private void MainboardSubTab_Click(object sender, RoutedEventArgs e)
    {
        if (sender is not ToggleButton clicked)
            return;

        MbSubTemp.IsChecked = ReferenceEquals(clicked, MbSubTemp);
        MbSubFanSpeed.IsChecked = ReferenceEquals(clicked, MbSubFanSpeed);
        MbSubFanControl.IsChecked = ReferenceEquals(clicked, MbSubFanControl);

        MbTempView.Visibility = MbSubTemp.IsChecked == true ? Visibility.Visible : Visibility.Collapsed;
        MbFanSpeedView.Visibility = MbSubFanSpeed.IsChecked == true ? Visibility.Visible : Visibility.Collapsed;
        MbFanControlView.Visibility = MbSubFanControl.IsChecked == true ? Visibility.Visible : Visibility.Collapsed;
    }

    private void SystemSubTab_Click(object sender, RoutedEventArgs e)
    {
        if (sender is not ToggleButton clicked)
            return;

        SysSubCpu.IsChecked = ReferenceEquals(clicked, SysSubCpu);
        SysSubRam.IsChecked = ReferenceEquals(clicked, SysSubRam);
        SysSubNet.IsChecked = ReferenceEquals(clicked, SysSubNet);
        SysSubDisk.IsChecked = ReferenceEquals(clicked, SysSubDisk);
        SysSubSynth.IsChecked = ReferenceEquals(clicked, SysSubSynth);

        var view = clicked switch
        {
            _ when ReferenceEquals(clicked, SysSubRam) => SystemSubView.Ram,
            _ when ReferenceEquals(clicked, SysSubNet) => SystemSubView.Network,
            _ when ReferenceEquals(clicked, SysSubDisk) => SystemSubView.DiskIo,
            _ when ReferenceEquals(clicked, SysSubSynth) => SystemSubView.SynthTemp,
            _ => SystemSubView.CpuUsage,
        };
        _service.SystemVm.SelectView(view);
        SystemGraph.Redraw();
    }

    private static float ParseValue(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return float.NaN;
        var sb = new System.Text.StringBuilder();
        foreach (char ch in text)
        {
            if (char.IsDigit(ch) || ch == '.' || ch == ',')
                sb.Append(ch);
            else if (sb.Length > 0)
                break;
        }
        string s = sb.ToString();
        if (s.Contains(',') && s.Contains('.'))
            s = s.Replace(",", "");
        else
            s = s.Replace(',', '.');
        return float.TryParse(s, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out float v)
            ? v
            : float.NaN;
    }

    private static float ParseTemp(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || text == "—")
            return float.NaN;
        string num = text.Replace("°C", "", StringComparison.OrdinalIgnoreCase).Trim();
        return float.TryParse(num, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out float v)
            ? v
            : float.NaN;
    }

    private void UpdateBanner()
    {
        if (_service.IsElevated && string.IsNullOrEmpty(_service.LastError))
        {
            ElevationBanner.Visibility = Visibility.Collapsed;
            return;
        }

        ElevationBanner.Visibility = Visibility.Visible;
        var loc = LocalizationService.Instance;
        if (!string.IsNullOrEmpty(_service.LastError))
            ElevationText.Text = loc.T("Banner.HwError") + _service.LastError;
        else
            ElevationText.Text = loc.T("Banner.NotElevated");
    }

    private void RefreshStatus()
    {
        var loc = LocalizationService.Instance;
        float cpuLoad = AverageCoreLoad();
        StatusCpu.Text = float.IsNaN(cpuLoad)
            ? $"{loc.T("Status.Cpu")} —"
            : $"{loc.T("Status.Cpu")} {cpuLoad:0.0} %";
        StatusRam.Text = FormatRam();

        if (_service.IsHardwareOpen &&
            _service.CpuInfo.Status.Contains("PawnIO", StringComparison.OrdinalIgnoreCase))
        {
            StatusText.Text = _service.CpuInfo.Status;
            StatusText.Foreground = System.Windows.Media.Brushes.White;
        }
        else if (_service.IsHardwareOpen && _service.Smart.Drives.Count > 0)
        {
            StatusText.Text = _service.Smart.OverallStatusText;
            StatusText.Foreground = _service.Smart.OverallStatusBrush;
        }
        else
        {
            StatusText.Text = _service.IsHardwareOpen
                ? $"Hardware OK · PWM={_service.FanControlCount}"
                : "Hardware OFF";
            StatusText.Foreground = System.Windows.Media.Brushes.White;
        }

        StatusTime.Text = $"{AppVersion.Display}  ·  {DateTime.Now:h:mm:ss tt}";
    }

    private float AverageCoreLoad()
    {
        float sum = 0;
        int n = 0;
        foreach (var row in _service.CpuInfo.Readings)
        {
            if (!row.Label.StartsWith("Core #", StringComparison.OrdinalIgnoreCase))
                continue;
            if (row.LoadText is null || row.LoadText == "—")
                continue;
            string s = row.LoadText.Replace("%", "").Trim();
            if (float.TryParse(s, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out float v))
            {
                sum += v;
                n++;
            }
        }

        return n == 0 ? float.NaN : sum / n;
    }

    private string FormatRam()
    {
        var loc = LocalizationService.Instance;
        try
        {
            using var searcher = new System.Management.ManagementObjectSearcher(
                "SELECT TotalVisibleMemorySize, FreePhysicalMemory FROM Win32_OperatingSystem");
            foreach (System.Management.ManagementObject obj in searcher.Get())
            {
                double totalKb = Convert.ToDouble(obj["TotalVisibleMemorySize"]);
                double freeKb = Convert.ToDouble(obj["FreePhysicalMemory"]);
                double usedGb = (totalKb - freeKb) / (1024.0 * 1024.0);
                double pct = (totalKb - freeKb) / totalKb * 100.0;
                return $"{loc.T("Status.Ram")} {usedGb:0.00} GB / {pct:0} %";
            }
        }
        catch
        {
            // ignore
        }

        return $"{loc.T("Status.Ram")} —";
    }

    private void UpdateTrayTemp()
    {
        if (_tray is null)
            return;
        float t = ResolveCpuWarningTemp();
        if (float.IsNaN(t))
            return;
        int ti = (int)Math.Round(t);
        string? dist = CurrentDistanceText();
        _tray.Text = dist is null
            ? $"{AppVersion.ProductName} - CPU {ti}°C"
            : $"{AppVersion.ProductName} - CPU {ti}°C (Δ TjMax {dist})";
        // NOTE: degree/delta written as C# unicode escapes in source below at build time.
        if (ti == _lastTrayTemp)
            return;
        _lastTrayTemp = ti;
        var old = _trayTempIcon;
        _trayTempIcon = TrayTempIcon.Create(ti);
        _tray.Icon = _trayTempIcon;
        old?.Dispose();
    }

    private void ToggleCompact()
    {
        if (_compact is not null)
        {
            _compact.Close();
            _compact = null;
            return;
        }
        _compact = new CompactWindow(this);
        _compact.Closed += (_, _) => _compact = null;
        _compact.Show();
    }

    internal float CurrentCpuTemp() => ResolveCpuWarningTemp();

    internal string? CurrentDistanceText()
    {
        foreach (var row in _service.CpuInfo.Readings)
        {
            if (row.Label.StartsWith("Jarak", StringComparison.OrdinalIgnoreCase))
                return row.CurrentText;
        }
        return null;
    }

    internal void RestoreFromCompact() => RestoreFromTray();

    private void InitTray()
    {
        _tray = new Forms.NotifyIcon
        {
            Text = AppVersion.ProductName,
            Visible = true,
            Icon = System.Drawing.SystemIcons.Application,
        };
        _tray.DoubleClick += (_, _) => RestoreFromTray();
        RebuildTrayMenu();
    }

    private void RebuildTrayMenu()
    {
        if (_tray is null)
            return;
        var loc = LocalizationService.Instance;
        var menu = new Forms.ContextMenuStrip();
        menu.Items.Add(loc.T("Tray.Open"), null, (_, _) => RestoreFromTray());
        menu.Items.Add("Mode Ringkas", null, (_, _) => ToggleCompact());
        menu.Items.Add(loc.T("Tray.Exit"), null, (_, _) =>
        {
            _reallyExit = true;
            Close();
        });
        _tray.ContextMenuStrip = menu;
    }

    private void RestoreFromTray()
    {
        Show();
        if (WindowState == WindowState.Minimized)
            WindowState = WindowState.Normal;
        Activate();
    }

    private void Window_StateChanged(object sender, EventArgs e)
    {
        if (WindowState == WindowState.Minimized)
        {
            Hide();
            var loc = LocalizationService.Instance;
            _tray?.ShowBalloonTip(800, AppVersion.ProductName, loc.T("Tray.Tip"), Forms.ToolTipIcon.Info);
            return;
        }

        // Maximized / restored: Viewbox scales content automatically.
    }

    private void Window_SizeChanged(object sender, SizeChangedEventArgs e)
    {
        // Viewbox handles uniform font/layout scaling to the 900×740 design canvas.
    }

    private void Window_Closing(object sender, CancelEventArgs e)
    {
        if (!_reallyExit)
        {
            e.Cancel = true;
            WindowState = WindowState.Minimized;
            return;
        }

        _uiTimer.Stop();
        _warnings.Dispose();
        if (_tray is not null)
        {
            _tray.Visible = false;
            _tray.Dispose();
            _tray = null;
        }
    }

    private void MenuSettings_Click(object sender, RoutedEventArgs e)
    {
        var dlg = new SettingsWindow(_warnings.Settings) { Owner = this };
        if (dlg.ShowDialog() == true && dlg.Result is not null)
            _warnings.ReplaceSettings(dlg.Result);
    }

    private void MenuSave_Click(object sender, RoutedEventArgs e) => _service.SaveProfile();

    private void MenuExit_Click(object sender, RoutedEventArgs e)
    {
        _reallyExit = true;
        Close();
    }

    private void MenuApplyStartup_Click(object sender, RoutedEventArgs e)
    {
        bool on = MenuApplyStartup.IsChecked;
        _service.Profile.ApplyOnStartupGlobal = on;
        ApplyStartupGlobal.IsChecked = on;
        GpuApplyStartup.IsChecked = on;
        _service.SaveProfile();
    }

    private void MenuPawnIo_Click(object sender, RoutedEventArgs e)
    {
        bool installed = PawnIoStatus.IsInstalled();
        var result = System.Windows.MessageBox.Show(
            installed
                ? "PawnIO sudah terdeteksi di sistem.\n\nJika suhu masih 0°C, restart PC atau reinstall PawnIO (versi standard).\n\nBuka halaman unduhan?"
                : "LibreHardwareMonitor 0.9.5+ membutuhkan driver PawnIO untuk membaca suhu AMD / SuperIO.\n" +
                  "Admin saja TIDAK cukup (WinRing0 sudah diganti).\n\nBuka halaman unduhan PawnIO?",
            "PawnIO",
            MessageBoxButton.YesNo,
            MessageBoxImage.Information);

        if (result == MessageBoxResult.Yes)
            PawnIoStatus.OpenDownloadPage();
    }

    private void MenuRestoreBios_Click(object sender, RoutedEventArgs e)
    {
        _service.EmergencyRestore();
        var loc = LocalizationService.Instance;
        System.Windows.MessageBox.Show(
            loc.T("Msg.BiosRestored"),
            AppVersion.ProductName,
            MessageBoxButton.OK,
            MessageBoxImage.Information);
    }

    private void MenuAbout_Click(object sender, RoutedEventArgs e)
    {
        var loc = LocalizationService.Instance;
        string body = string.Format(
            loc.T("About.Body"),
            AppVersion.ProductName,
            AppVersion.Display);
        System.Windows.MessageBox.Show(
            body,
            loc.T("About.Title"),
            MessageBoxButton.OK,
            MessageBoxImage.Information);
    }

    private void ApplyStartupGlobal_Changed(object sender, RoutedEventArgs e)
    {
        bool on = ApplyStartupGlobal.IsChecked == true;
        _service.Profile.ApplyOnStartupGlobal = on;
        MenuApplyStartup.IsChecked = on;
        GpuApplyStartup.IsChecked = on;
        _service.SaveProfile();
    }

    private void GpuApplyStartup_Changed(object sender, RoutedEventArgs e)
    {
        bool on = GpuApplyStartup.IsChecked == true;
        _service.Profile.ApplyOnStartupGlobal = on;
        ApplyStartupGlobal.IsChecked = on;
        MenuApplyStartup.IsChecked = on;
        _service.SaveProfile();
    }

    private FanChannelConfig? ConfigFromTag(object sender)
    {
        if (sender is FrameworkElement { Tag: FanRow row })
            return _service.Logic.GetChannel(row.ChannelIndex);
        return null;
    }

    private void FanMode_Changed(object sender, SelectionChangedEventArgs e)
    {
        if (sender is not ComboBox { DataContext: FanRow row })
            return;
        var cfg = _service.Logic.GetChannel(row.ChannelIndex);
        cfg.Mode = row.Mode;
        _service.ApplyChannel(cfg);
    }

    private void FanSource_Changed(object sender, SelectionChangedEventArgs e)
    {
        if (sender is not ComboBox { DataContext: FanRow row })
            return;
        var cfg = _service.Logic.GetChannel(row.ChannelIndex);
        cfg.TemperatureSource = row.Source;
        _service.ApplyChannel(cfg);
    }

    private void FanApplyStartup_Changed(object sender, RoutedEventArgs e)
    {
        if (sender is not CheckBox { DataContext: FanRow row })
            return;
        var cfg = _service.Logic.GetChannel(row.ChannelIndex);
        cfg.ApplyOnStartup = row.ApplyOnStartup;
        cfg.Name = row.Name;
        _service.ApplyChannel(cfg);
    }

    private void ManualApply_Click(object sender, RoutedEventArgs e)
    {
        if (ConfigFromTag(sender) is not { } cfg)
            return;
        if (sender is FrameworkElement { Tag: FanRow row })
        {
            cfg.Name = row.Name;
            cfg.ManualPwmPercent = (float)row.ManualPwm;
            cfg.Mode = FanChannelMode.Manual;
            row.Mode = FanChannelMode.Manual;
        }

        _service.ApplyChannel(cfg);
    }

    private void Curve_Click(object sender, RoutedEventArgs e)
    {
        if (ConfigFromTag(sender) is not { } cfg)
            return;

        var slot = cfg.Controllers[0];
        var dlg = new CurveEditorWindow(slot.Curve) { Owner = this };
        if (dlg.ShowDialog() == true)
        {
            slot.Curve = dlg.ResultCurve;
            cfg.Mode = FanChannelMode.Software;
            _service.ApplyChannel(cfg);
        }
    }

    private void Multi_Click(object sender, RoutedEventArgs e)
    {
        if (ConfigFromTag(sender) is not { } cfg)
            return;

        var dlg = new MultiControllerWindow(cfg) { Owner = this };
        if (dlg.ShowDialog() == true)
        {
            cfg.TemperatureSource = TemperatureSourceKind.MultipleControllers;
            cfg.Mode = FanChannelMode.Software;
            _service.ApplyChannel(cfg);
            if (sender is FrameworkElement { Tag: FanRow row })
            {
                row.Source = TemperatureSourceKind.MultipleControllers;
                row.Mode = FanChannelMode.Software;
            }
        }
    }

    private void Advanced_Click(object sender, RoutedEventArgs e)
    {
        if (ConfigFromTag(sender) is not { } cfg)
            return;

        var dlg = new AdvancedOptionsWindow(cfg) { Owner = this };
        if (dlg.ShowDialog() == true)
            _service.ApplyChannel(cfg);
    }

    private void OnPropertyChanged([CallerMemberName] string? name = null) =>
        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
}
