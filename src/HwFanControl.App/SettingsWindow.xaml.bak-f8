<Window x:Class="HwFanControl.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ART-Monitor - Settings"
        Height="560" Width="720"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#E8ECF0"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="10,8,10,10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderBrush" Value="#7A9BC8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#F7F8FA"/>
      <Setter Property="Foreground" Value="#1A3A6E"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#202020"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
      <Button Content="Cancel" Width="88" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="180"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
      </Grid.ColumnDefinitions>

      <!-- Left sidebar tree -->
      <Border Grid.Column="0" Background="#F4F6F8" BorderBrush="#ABADB3" BorderThickness="1" Padding="4">
        <TreeView x:Name="NavTree" BorderThickness="0" Background="Transparent"
                  SelectedItemChanged="NavTree_SelectedItemChanged">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="True"/>
              <Setter Property="Padding" Value="2,2"/>
              <Setter Property="FontSize" Value="12"/>
            </Style>
          </TreeView.ItemContainerStyle>

          <TreeViewItem Header=">> Settings" FontWeight="SemiBold" Foreground="#1A3A6E" IsExpanded="True">
            <TreeViewItem Header="General" Tag="settings.general"/>
            <TreeViewItem Header="Display" Tag="settings.display"/>
            <TreeViewItem Header="Profiles" Tag="settings.profiles"/>
            <TreeViewItem Header="Mainboard" Tag="settings.mainboard"/>
            <TreeViewItem Header="GPU" Tag="settings.gpu"/>
            <TreeViewItem Header="S.M.A.R.T." Tag="settings.smart"/>
            <TreeViewItem Header="Active Modules" Tag="settings.modules"/>
            <TreeViewItem Header="Logging" Tag="settings.logging"/>
            <TreeViewItem Header="Miscellaneous" Tag="settings.misc"/>
          </TreeViewItem>

          <TreeViewItem Header=">> Warnings" FontWeight="SemiBold" Foreground="#1A3A6E" IsExpanded="True">
            <TreeViewItem Header="Warnings" Tag="warn.general"/>
            <TreeViewItem x:Name="NavCpu" Header="Sensors: CPU" Tag="warn.cpu"/>
            <TreeViewItem Header="Sensors: CPU Cores" Tag="warn.cpu_cores"/>
            <TreeViewItem Header="Sensors: GPU" Tag="warn.gpu"/>
            <TreeViewItem Header="Sensors: Drives" Tag="warn.drives"/>
            <TreeViewItem Header="Sensors: Mainboard / Temp." Tag="warn.mb_temp"/>
            <TreeViewItem Header="Sensors: Mainboard / Fans" Tag="warn.mb_fans"/>
          </TreeViewItem>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D0D4D8"/>

      <!-- Right content -->
      <Border Grid.Column="2" Background="#F0F2F5" BorderBrush="#ABADB3" BorderThickness="1" Padding="10">
        <Grid>
          <!-- Placeholder pages -->
          <StackPanel x:Name="PagePlaceholder" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PlaceholderTitle" Text="—" FontSize="16" FontWeight="SemiBold"
                       Foreground="#1A3A6E" HorizontalAlignment="Center"/>
            <TextBlock Text="Settings page placeholder — coming soon."
                       Margin="0,8,0,0" Foreground="#555" HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- CPU Temperature warning page -->
          <ScrollViewer x:Name="PageCpuWarning" VerticalScrollBarVisibility="Auto" Visibility="Visible">
            <StackPanel>
              <Border BorderBrush="#7A9BC8" BorderThickness="1" Background="#EEF2F7" Padding="8" Margin="0,0,0,12">
                <TextBlock Text="CPU Temperature" FontWeight="SemiBold" FontSize="14"
                           Foreground="#1A3A6E" HorizontalAlignment="Center"/>
              </Border>

              <GroupBox Header="CPU Temperature Warning">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#0066CC" Margin="0,0,0,8"
                             Text="You can set the individual warning thresholds for each CPU on the left-hand side in the tree view (Sensors:)."/>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Warning threshold" VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="CpuThresholdBox" Width="56" Text="95"/>
                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>

                  <CheckBox x:Name="ChkMessageBox" Content="Display a message box"/>
                  <CheckBox x:Name="ChkLogfile" Content="Write to logfile"/>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkSound" Content="Play a sound" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="..." Width="32" Click="BrowseSound_Click" ToolTip="Browse sound file"/>
                    <TextBox Grid.Column="2" x:Name="SoundPathBox" Margin="4,0,0,0"/>
                    <Button Grid.Column="3" Content="▶" Width="32" Click="PreviewSound_Click" ToolTip="Preview sound"/>
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkEmail" Content="Send an e-mail to" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="EmailBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkRunProgram" Content="Run a program" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="..." Width="32" Click="BrowseProgram_Click" ToolTip="Browse program"/>
                    <TextBox Grid.Column="2" x:Name="ProgramPathBox" Margin="4,0,0,0"/>
                  </Grid>

                  <Grid Margin="24,2,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Optional parameters" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="ProgramArgsBox"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="ChkHysteresis" Content="Hysteresis" VerticalAlignment="Center"/>
                    <TextBox x:Name="HysteresisBox" Width="48" Text="10" Margin="8,0,0,0"/>
                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>

              <GroupBox Header="General Repeat Settings For All Warnings">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Display a message box" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="RepeatMessageBox" Width="48" Text="1"/>
                    <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Write to logfile" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="RepeatLogfile" Width="48" Text="2"/>
                    <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Play a sound" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="RepeatSound" Width="48" Text="1"/>
                    <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Send an e-mail" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="RepeatEmail" Width="48" Text="60"/>
                    <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Run a program" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="RepeatProgram" Width="48" Text="120"/>
                    <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>

          <!-- GPU Temperature warning page -->
          <ScrollViewer x:Name="PageGpuWarning" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <Border BorderBrush="#7A9BC8" BorderThickness="1" Background="#EEF2F7" Padding="8" Margin="0,0,0,12">
                <TextBlock Text="GPU Temperature" FontWeight="SemiBold" FontSize="14"
                           Foreground="#1A3A6E" HorizontalAlignment="Center"/>
              </Border>

              <GroupBox Header="GPU Temperature Warning">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#0066CC" Margin="0,0,0,8"
                             Text="Warning when the hottest GPU reading (edge / junction / hotspot) reaches the threshold."/>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Warning threshold" VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="GpuThresholdBox" Width="56" Text="88"/>
                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>

                  <CheckBox x:Name="GpuChkMessageBox" Content="Display a message box"/>
                  <CheckBox x:Name="GpuChkLogfile" Content="Write to logfile"/>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="GpuChkSound" Content="Play a sound" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="GpuSoundPathBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="GpuChkEmail" Content="Send an e-mail to" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="GpuEmailBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="GpuChkRunProgram" Content="Run a program" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="GpuProgramPathBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="24,2,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Optional parameters" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="GpuProgramArgsBox"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="GpuChkHysteresis" Content="Hysteresis" VerticalAlignment="Center"/>
                    <TextBox x:Name="GpuHysteresisBox" Width="48" Text="10" Margin="8,0,0,0"/>
                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>

          <!-- Drives Temperature warning page -->
          <ScrollViewer x:Name="PageDrivesWarning" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <Border BorderBrush="#7A9BC8" BorderThickness="1" Background="#EEF2F7" Padding="8" Margin="0,0,0,12">
                <TextBlock Text="Drive Temperature" FontWeight="SemiBold" FontSize="14"
                           Foreground="#1A3A6E" HorizontalAlignment="Center"/>
              </Border>

              <GroupBox Header="Drive Temperature Warning">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#0066CC" Margin="0,0,0,8"
                             Text="Warning when the hottest HDD / NVMe / SSD reaches the threshold."/>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Warning threshold" VerticalAlignment="Center" Width="130"/>
                    <TextBox x:Name="DrvThresholdBox" Width="56" Text="65"/>
                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>

                  <CheckBox x:Name="DrvChkMessageBox" Content="Display a message box"/>
                  <CheckBox x:Name="DrvChkLogfile" Content="Write to logfile"/>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="DrvChkSound" Content="Play a sound" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="DrvSoundPathBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="DrvChkEmail" Content="Send an e-mail to" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="DrvEmailBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="DrvChkRunProgram" Content="Run a program" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="DrvProgramPathBox" Margin="8,0,0,0"/>
                  </Grid>

                  <Grid Margin="24,2,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Optional parameters" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="DrvProgramArgsBox"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="DrvChkHysteresis" Content="Hysteresis" VerticalAlignment="Center"/>
                    <TextBox x:Name="DrvHysteresisBox" Width="48" Text="10" Margin="8,0,0,0"/>
                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>

          <!-- Fan failure warning page -->
          <ScrollViewer x:Name="PageFansWarning" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <Border BorderBrush="#7A9BC8" BorderThickness="1" Background="#EEF2F7" Padding="8" Margin="0,0,0,12">
                <TextBlock Text="Fan Failure" FontWeight="SemiBold" FontSize="14"
                           Foreground="#1A3A6E" HorizontalAlignment="Center"/>
              </Border>

              <GroupBox Header="Fan Failure Warning">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="#0066CC" Margin="0,0,0,8"
                             Text="Warning when a fan that has spun before is driven at 25% or more but reports 0 RPM for the time below. Unconnected fan headers are ignored."/>

                  <CheckBox x:Name="ChkFanEnabled" Content="Enable fan failure warning"/>

                  <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="Stall time before warning" VerticalAlignment="Center" Width="180"/>
                    <TextBox x:Name="FanStallBox" Width="48" Text="10"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>

                  <CheckBox x:Name="ChkFanBox" Content="Display a message box"/>
                  <CheckBox x:Name="ChkFanLog" Content="Write to logfile"/>
                  <CheckBox x:Name="ChkFanSound" Content="Play a sound (uses the CPU warning sound file)"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
