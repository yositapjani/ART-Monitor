<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ART-Monitor</AssemblyName>
    <RootNamespace>ArtMonitor.Bootstrapper</RootNamespace>
    <ApplicationIcon>..\..\src\HwFanControl.App\app.ico</ApplicationIcon>
    <Product>ART-Monitor</Product>
    <AssemblyTitle>ART-Monitor Launcher</AssemblyTitle>
    <Company>ART-Monitor</Company>
    <Description>ART-Monitor portable launcher - checks for .NET 8 Desktop Runtime and PawnIO, installs them via winget when missing, then starts ART-Monitor.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\publish-fd\ART-Monitor.exe" LogicalName="AppExe" />
  </ItemGroup>

</Project>
