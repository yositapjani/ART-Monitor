    private static float ParseValue(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return float.NaN;
        var sb = new System.Text.StringBuilder();
        foreach (char ch in text)
        {
            if (char.IsDigit(ch) || ch == '.' || ch == ',')
                sb.Append(ch);
            else if (sb.Length > 0)
                break;
        }
        string s = sb.ToString();
        if (s.Contains(',') && s.Contains('.'))
            s = s.Replace(",", "");
        else
            s = s.Replace(',', '.');
        return float.TryParse(s, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out float v)
            ? v
            : float.NaN;
    }

    private static float ParseTemp(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || text == "—")
            return float.NaN;
        string num = text.Replace("°C", "", StringComparison.OrdinalIgnoreCase).Trim();
        return float.TryParse(num, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out float v)
            ? v
            : float.NaN;
    }

    private void UpdateBanner()
    {
        if (_service.IsElevated && string.IsNullOrEmpty(_service.LastError))
        {
            ElevationBanner.Visibility = Visibility.Collapsed;
            return;
        }

        ElevationBanner.Visibility = Visibility.Visible;
        var loc = LocalizationService.Instance;
        if (!string.IsNullOrEmpty(_service.LastError))
            ElevationText.Text = loc.T("Banner.HwError") + _service.LastError;
        else
            ElevationText.Text = loc.T("Banner.NotElevated");
    }

    private void RefreshStatus()
    {
        var loc = LocalizationService.Instance;
        float cpuLoad = AverageCoreLoad();
        StatusCpu.Text = float.IsNaN(cpuLoad)
            ? $"{loc.T("Status.Cpu")} —"
            : $"{loc.T("Status.Cpu")} {cpuLoad:0.0} %";
        StatusRam.Text = FormatRam();

        if (_service.IsHardwareOpen &&
            _service.CpuInfo.Status.Contains("PawnIO", StringComparison.OrdinalIgnoreCase))
        {
            StatusText.Text = _service.CpuInfo.Status;
            StatusText.Foreground = System.Windows.Media.Brushes.White;
        }
        else if (_service.IsHardwareOpen && _service.Smart.Drives.Count > 0)
        {
            StatusText.Text = _service.Smart.OverallStatusText;
            StatusText.Foreground = _service.Smart.OverallStatusBrush;
        }
        else
        {
            StatusText.Text = _service.IsHardwareOpen
                ? $"Hardware OK · PWM={_service.FanControlCount}"
                : "Hardware OFF";
            StatusText.Foreground = System.Windows.Media.Brushes.White;
        }

        StatusTime.Text = $"{AppVersion.Display}  ·  {DateTime.Now:h:mm:ss tt}";
    }

    private float AverageCoreLoad()
    {
        float sum = 0;
        int n = 0;
        foreach (var row in _service.CpuInfo.Readings)
        {
            if (!row.Label.StartsWith("Core #", StringComparison.OrdinalIgnoreCase))
                continue;
            if (row.LoadText is null || row.LoadText == "—")
                continue;
            string s = row.LoadText.Replace("%", "").Trim();
            if (float.TryParse(s, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out float v))
            {
                sum += v;
                n++;
            }
        }

        return n == 0 ? float.NaN : sum / n;
    }

    private string FormatRam()
    {
        var loc = LocalizationService.Instance;
        try
        {
            using var searcher = new System.Management.ManagementObjectSearcher(
                "SELECT TotalVisibleMemorySize, FreePhysicalMemory FROM Win32_OperatingSystem");
            foreach (System.Management.ManagementObject obj in searcher.Get())
            {
                double totalKb = Convert.ToDouble(obj["TotalVisibleMemorySize"]);
                double freeKb = Convert.ToDouble(obj["FreePhysicalMemory"]);
                double usedGb = (totalKb - freeKb) / (1024.0 * 1024.0);
                double totalGb = totalKb / (1024.0 * 1024.0);
                double pct = (totalKb - freeKb) / totalKb * 100.0;
                _service.CpuInfo.MemoryUsage = $"{usedGb:0.00} GB / {totalGb:0.00} GB ({pct:0}%)";
                return $"{loc.T("Status.Ram")} {usedGb:0.00} GB / {pct:0} %";
            }
        }
        catch
        {
            // ignore
        }

        return $"{loc.T("Status.Ram")} —";
    }

    private void UpdateTrayTemp()
    {
        if (_tray is null)
            return;
        float t = ResolveCpuWarningTemp();
        if (float.IsNaN(t))
            return;
        int ti = (int)Math.Round(t);
        string? dist = CurrentDistanceText();
        _tray.Text = dist is null
            ? $"{AppVersion.ProductName} - CPU {ti}°C"
            : $"{AppVersion.ProductName} - CPU {ti}°C (Δ TjMax {dist})";
        // NOTE: degree/delta written as C# unicode escapes in source below at build time.
        if (ti == _lastTrayTemp)
            return;
        _lastTrayTemp = ti;
        var old = _trayTempIcon;
        _trayTempIcon = TrayTempIcon.Create(ti);
        _tray.Icon = _trayTempIcon;
        old?.Dispose();
    }

    private void ToggleCompact()
    {
        if (_compact is not null)
        {
            _compact.Close();
            _compact = null;
            return;
        }
        _compact = new CompactWindow(this);
        _compact.Closed += (_, _) => _compact = null;
        _compact.Show();
    }

    internal float CurrentCpuTemp() => ResolveCpuWarningTemp();

    internal string? CurrentDistanceText()
    {
        foreach (var row in _service.CpuInfo.Readings)
        {
            if (row.Label.StartsWith("Jarak", StringComparison.OrdinalIgnoreCase))
                return row.CurrentText;
        }
        return null;
    }

    internal void RestoreFromCompact() => RestoreFromTray();

    private void InitTray()
    {
        _tray = new Forms.NotifyIcon
        {
            Text = AppVersion.ProductName,
            Visible = true,
            Icon = System.Drawing.SystemIcons.Application,
        };
        _tray.DoubleClick += (_, _) => RestoreFromTray();
        RebuildTrayMenu();
    }

    private void RebuildTrayMenu()
    {
        if (_tray is null)
            return;
        var loc = LocalizationService.Instance;
        var menu = new Forms.ContextMenuStrip();
        menu.Items.Add(loc.T("Tray.Open"), null, (_, _) => RestoreFromTray());
        menu.Items.Add("Mode Ringkas", null, (_, _) => ToggleCompact());
        menu.Items.Add(loc.T("Tray.Exit"), null, (_, _) =>
        {
            _reallyExit = true;
            Close();
        });
        _tray.ContextMenuStrip = menu;
    }

    private void RestoreFromTray()
    {
        Show();
        if (WindowState == WindowState.Minimized)
            WindowState = WindowState.Normal;
        Activate();
    }

    private void Window_StateChanged(object sender, EventArgs e)
    {
        if (WindowState == WindowState.Minimized)
        {
            Hide();
            var loc = LocalizationService.Instance;
            _tray?.ShowBalloonTip(800, AppVersion.ProductName, loc.T("Tray.Tip"), Forms.ToolTipIcon.Info);
            return;
        }

        // Maximized / restored: Viewbox scales content automatically.
    }

    private void Window_SizeChanged(object sender, SizeChangedEventArgs e)
    {
        // Viewbox handles uniform font/layout scaling to the 900×740 design canvas.
    }

    private void Window_Closing(object sender, CancelEventArgs e)
    {
        if (!_reallyExit)
        {
            e.Cancel = true;
            WindowState = WindowState.Minimized;
            return;
        }

        _uiTimer.Stop();
        _warnings.Dispose();
        if (_tray is not null)
        {
            _tray.Visible = false;
            _tray.Dispose();
            _tray = null;
        }
    }

    private void MenuSettings_Click(object sender, RoutedEventArgs e)
    {
        bool autoStart = AutoStartTaskExists();
        var app = new AppSettingsSnapshot
        {
            Language = LocalizationService.Instance.Language,
            AutoStartEnabled = autoStart,
            LoggingEnabled = _service.Profile.Logging.Enabled,
            LoggingIntervalSeconds = _service.Profile.Logging.IntervalSeconds,
        };
        var dlg = new SettingsWindow(_warnings.Settings, app) { Owner = this };
        if (dlg.ShowDialog() != true)
            return;
        if (dlg.Result is not null)
            _warnings.ReplaceSettings(dlg.Result);
        if (dlg.AppResult is { } res)
        {
            LocalizationService.Instance.Language = res.Language;
            _service.Profile.Logging.Enabled = res.LoggingEnabled;
            _service.Profile.Logging.IntervalSeconds = Math.Max(1, res.LoggingIntervalSeconds);
            _service.SaveProfile();
            MenuLogging.IsChecked = res.LoggingEnabled;
            if (res.AutoStartEnabled != autoStart)
                SetAutoStartTask(res.AutoStartEnabled);
        }
    }

    private static bool AutoStartTaskExists()
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo("schtasks.exe", "/query /tn \"ART-Monitor-AutoStart\"")
            {
                UseShellExecute = false,
                CreateNoWindow = true,
                RedirectStandardOutput = true,
            };
            using var p = System.Diagnostics.Process.Start(psi);
            if (p is null)
                return false;
            p.WaitForExit(3000);
            return p.ExitCode == 0;
        }
        catch
        {
            return false;
        }
    }

    private static void SetAutoStartTask(bool enable)
    {
        try
        {
            System.Diagnostics.ProcessStartInfo psi;
            if (enable)
            {
                string exe = Environment.ProcessPath ?? "";
                if (exe.Length == 0)
                    return;
                psi = new System.Diagnostics.ProcessStartInfo("schtasks.exe",
                    $"/create /tn \"ART-Monitor-AutoStart\" /tr \"\\\"{exe}\\\"\" /sc ONLOGON /delay 0000:15 /rl HIGHEST /f")
                { UseShellExecute = false, CreateNoWindow = true };
            }
            else
            {
                psi = new System.Diagnostics.ProcessStartInfo("schtasks.exe",
                    "/delete /tn \"ART-Monitor-AutoStart\" /f")
                { UseShellExecute = false, CreateNoWindow = true };
            }

            using var p = System.Diagnostics.Process.Start(psi);
            p?.WaitForExit(5000);
        }
        catch
        {
            // Best effort: autostart toggling must never crash the app.
        }
    }

