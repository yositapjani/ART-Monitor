    public MainWindow()
    {
        InitializeComponent();
        DataContext = this;
        _service = App.Service;
        _warnings = new WarningMonitor(Dispatcher);

        TempList.ItemsSource = _service.Temperatures;
        FanList.ItemsSource = _service.Fans;
        CpuTempLegend.ItemsSource = _graph.Legend;
        TempGraph.Bind(_graph);
        _activeCpuGraph = _graph;
        GpuFanMode.SelectionChanged += GpuFanMode_Changed;
        OverviewPairs.ItemsSource = _service.Overview.Pairs;
        OverviewCores.ItemsSource = _service.Overview.Cores;
        OverviewLegend.ItemsSource = _service.Overview.Legend;
        OverviewGraph.Bind(_service.Overview);
        GpuLegend.ItemsSource = _service.Gpu.Legend;
        GpuGraph.Bind(_service.Gpu);
        HdTempLegend.ItemsSource = _service.HdTemp.Legend;
        HdTempGraph.Bind(_service.HdTemp);
        MainboardLegend.ItemsSource = _service.Mainboard.Legend;
        MainboardFanList.ItemsSource = _service.Mainboard.Fans;
        MainboardGraph.Bind(_service.Mainboard);
        SystemGraph.Bind(_service.SystemVm);

        ApplyStartupGlobal.IsChecked = _service.Profile.ApplyOnStartupGlobal;
        MenuApplyStartup.IsChecked = _service.Profile.ApplyOnStartupGlobal;
        MenuLogging.IsChecked = _service.Profile.Logging.Enabled;
        GpuApplyStartup.IsChecked = _service.Profile.ApplyOnStartupGlobal;

        UpdateBanner();
        ApplyLocalization();
        LocalizationService.Instance.LanguageChanged += () => Dispatcher.BeginInvoke(ApplyLocalization);
        InitTray();
        RefreshAllUi();
        OnPropertyChanged(nameof(CpuInfo));

        _uiTimer = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(1000) };
        _uiTimer.Tick += (_, _) => RefreshAllUi();
        _uiTimer.Start();

        _service.UiTick += () => Dispatcher.BeginInvoke(RefreshAllUi);
    }

    private void RefreshAllUi()
    {
        try
        {
            _service.ApplyCpuToUi();
            _service.ApplyOverviewToUi();
            _service.ApplyGpuToUi();
            if (!_gpuFanUiInit && _service.IsHardwareOpen)
            {
                _gpuFanUiInit = true;
                GpuFanMode.SelectedIndex = _service.Profile.GpuFan.SoftwareControl ? 1 : 0;
            }
            _service.ApplyGpuFanControl();
            _service.ApplyHdTempToUi();
            _service.ApplySmartToUi();
            _service.ApplyMainboardToUi();
            _service.ApplySystemToUi();
            UpdateGraphFromCpu();
            OverviewGraph.Redraw();
            GpuGraph.Redraw();
            HdTempGraph.Redraw();
            MainboardGraph.Redraw();
            SystemGraph.Redraw();
            RefreshStatus();
            _warnings.Tick(ResolveCpuWarningTemp());
            UpdateTrayTemp();
            _compact?.RefreshData();
        }
        catch (Exception ex)
        {
            StatusText.Text = "Error: " + ex.Message;
            StatusText.Foreground = System.Windows.Media.Brushes.OrangeRed;
        }
    }

    private void ApplyLocalization()
    {
        var loc = LocalizationService.Instance;
        Title = $"{AppVersion.ProductName} {AppVersion.Display}";
        MenuFile.Header = loc.T("Menu.File");
        MenuSaveProfile.Header = loc.T("Menu.SaveProfile");
        MenuExit.Header = loc.T("Menu.Exit");
        MenuOptions.Header = loc.T("Menu.Options");
        MenuApplyStartup.Header = loc.T("Menu.ApplyStartup");
        MenuSettings.Header = loc.T("Menu.Settings");
        MenuLanguage.Header = loc.T("Menu.Language");
        MenuLangEn.Header = loc.T("Lang.English");
        MenuLangId.Header = loc.T("Lang.Indonesian");
        MenuLangEn.IsChecked = loc.IsEnglish;
        MenuLangId.IsChecked = loc.IsIndonesian;
        MenuTools.Header = loc.T("Menu.Tools");
        MenuPawnIo.Header = loc.T("Menu.PawnIO");
        MenuRestoreBios.Header = loc.T("Menu.RestoreBios");
        MenuHelp.Header = loc.T("Menu.Help");
        MenuAbout.Header = loc.T("Menu.About");
        FanTempsGroup.Header = loc.T("Fan.Temps");
        ApplyStartupGlobal.Content = loc.T("Fan.ApplyStartup");
        UpdateBanner();
        RefreshStatus();
        if (_tray is not null)
        {
            _tray.Text = AppVersion.ProductName;
            RebuildTrayMenu();
        }
    }

    private void MenuLangEn_Click(object sender, RoutedEventArgs e)
