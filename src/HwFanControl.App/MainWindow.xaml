<Window x:Class="HwFanControl.App.MainWindow"
        WindowState="Maximized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:HwFanControl.App.Controls"
        Title="ART-Monitor"
        Height="780" Width="900"
        MinHeight="520" MinWidth="720"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
  <Window.Resources>
    <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#2B5AA0" Offset="0"/>
      <GradientStop Color="#6FA0D6" Offset="0.55"/>
      <GradientStop Color="#A8C8E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#1B3A6E" Offset="0"/>
      <GradientStop Color="#2B5AA0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BoxBrush" Color="White"/>
    <SolidColorBrush x:Key="BoxTextBrush" Color="#111111"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AltRowBrush" Color="#F0F0F0"/>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
    </Style>

    <!-- Argus-style main tabs -->
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="{DynamicResource TabBrush}" BorderBrush="#6FA0D6" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#FEE88A" Offset="0"/>
                      <GradientStop Color="#FCD830" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="#111"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="False">
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Argus-style CPU sub-tabs -->
    <Style x:Key="ArgusSubTab" TargetType="ToggleButton">
      <Setter Property="Padding" Value="12,3"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#6FA0D6"/>
      <Setter Property="Background" Value="{DynamicResource TabBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#FEE88A" Offset="0"/>
                      <GradientStop Color="#FCD830" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="#111"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Fixed design canvas; Viewbox scales fonts/layout when window is maximized/resized -->
  <DockPanel x:Name="RootDock">
    <Menu DockPanel.Dock="Top" Background="#F0F0F0">
      <MenuItem x:Name="MenuFile" Header="_File">
        <MenuItem x:Name="MenuSaveProfile" Header="Save profile" Click="MenuSave_Click"/>
        <Separator/>
        <MenuItem x:Name="MenuExit" Header="Exit" Click="MenuExit_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuOptions" Header="_Options">
        <MenuItem x:Name="MenuApplyStartup" Header="Apply on startup" IsCheckable="True" Click="MenuApplyStartup_Click"/>
        <MenuItem x:Name="MenuLogging" Header="Log to CSV (10s)" IsCheckable="True" Click="MenuLogging_Click"/>
        <Separator/>
        <MenuItem x:Name="MenuSettings" Header="Settings…" Click="MenuSettings_Click"/>
        <MenuItem x:Name="MenuLanguage" Header="Language">
          <MenuItem x:Name="MenuLangEn" Header="English" IsCheckable="True" Click="MenuLangEn_Click"/>
          <MenuItem x:Name="MenuLangId" Header="Indonesia" IsCheckable="True" Click="MenuLangId_Click"/>
        </MenuItem>
      </MenuItem>
      <MenuItem x:Name="MenuTools" Header="_Tools">
        <MenuItem x:Name="MenuPawnIo" Header="Install PawnIO (AMD CPU temps)…" Click="MenuPawnIo_Click"/>
        <MenuItem x:Name="MenuRestoreBios" Header="Restore BIOS fan control" Click="MenuRestoreBios_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuHelp" Header="_Help">
        <MenuItem x:Name="MenuAbout" Header="About" Click="MenuAbout_Click"/>
      </MenuItem>
    </Menu>

    <Border x:Name="ElevationBanner" DockPanel.Dock="Top" Background="#FFF3CD" Padding="8" Margin="8,4,8,0" Visibility="Collapsed">
      <TextBlock x:Name="ElevationText" TextWrapping="Wrap" Foreground="#856404"/>
    </Border>

    <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Background="#1B3A6E" Foreground="White">
      <StatusBarItem>
        <TextBlock x:Name="StatusCpu" Text="CPU Usage —" Margin="8,0"/>
      </StatusBarItem>
      <Separator Background="#4A6FA5" Width="1" Margin="4,2"/>
      <StatusBarItem>
        <TextBlock x:Name="StatusRam" Text="RAM Usage —" Margin="8,0"/>
      </StatusBarItem>
      <Separator Background="#4A6FA5" Width="1" Margin="4,2"/>
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="ART-Monitor" Margin="8,0"/>
      </StatusBarItem>
      <Separator Background="#4A6FA5" Width="1" Margin="4,2"/>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock x:Name="StatusTime" Text="" Margin="8,0"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" Margin="8,0">
          <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="ThemeSelector" Width="76" SelectionChanged="ThemeSelector_Changed">
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="Dark"/>
          </ComboBox>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <TabControl x:Name="MainTabs" Margin="8" Background="Transparent">
      <!-- ===== Overview (Argus style) ===== -->
      <TabItem Header="Overview">
        <Border Background="{DynamicResource PageBrush}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="470"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Left column: Core Temp-style panel + Argus pairs (GPU/HDD) -->
            <StackPanel Grid.RowSpan="2">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Select CPU:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="8,0,4,0" Padding="6,2">
                  <TextBlock Text="{Binding CpuInfo.ProcessorLabel}" Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <Border Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="4,0" Padding="6,2">
                  <TextBlock Text="{Binding CpuInfo.CoresText}" Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <Border Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="4,0" Padding="6,2">
                  <TextBlock Text="{Binding CpuInfo.ThreadsText}" Foreground="{DynamicResource TextBrush}"/>
                </Border>
              </StackPanel>
              <GroupBox Header="Processor &amp; Memory Information" Foreground="White" BorderBrush="#6FA0D6" Background="Transparent" Margin="0,4,0,0" Padding="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="92"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Model:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Model}"/>
                  </Border>
                  <TextBlock Grid.Row="1" Text="Platform:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Platform}"/>
                  </Border>
                  <TextBlock Grid.Row="2" Text="Frequency:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Frequency}"/>
                  </Border>
                  <TextBlock Grid.Row="3" Text="VID:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Vid}"/>
                  </Border>
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="Effective clock:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="3" Grid.Column="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.EffectiveClock}"/>
                  </Border>
                  <TextBlock Grid.Row="4" Text="Revision:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="4" Grid.Column="1" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Revision}"/>
                  </Border>
                  <TextBlock Grid.Row="4" Grid.Column="2" Text="Lithography:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="4" Grid.Column="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Lithography}"/>
                  </Border>
                  <TextBlock Grid.Row="5" Text="CPUID:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="5" Grid.Column="1" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.CpuId}"/>
                  </Border>
                  <TextBlock Grid.Row="5" Grid.Column="2" Text="TDP:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="5" Grid.Column="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.Tdp}"/>
                  </Border>
                  <TextBlock Grid.Row="6" Text="Memory:" Foreground="White" VerticalAlignment="Center"/>
                  <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,1" Padding="4,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                    <TextBlock Text="{Binding CpuInfo.MemoryUsage}"/>
                  </Border>
                </Grid>
              </GroupBox>
              <GroupBox Header="{Binding CpuInfo.ReadingsTitle}" Foreground="White" BorderBrush="#6FA0D6" Background="Transparent" Margin="0,6,0,0" Padding="6">
                <StackPanel>
                  <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="74"/>
                      <ColumnDefinition Width="62"/>
                      <ColumnDefinition Width="62"/>
                      <ColumnDefinition Width="62"/>
                      <ColumnDefinition Width="62"/>
                      <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="Min." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Max." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Avg." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Load" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                  </Grid>
                  <ItemsControl x:Name="OverviewReadings" ItemsSource="{Binding OverviewVm.Readings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="46"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Foreground="White" VerticalAlignment="Center"/>
                          <Border Grid.Column="1" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Center"/>
                          </Border>
                          <Border Grid.Column="2" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                            <TextBlock Text="{Binding Min}" HorizontalAlignment="Center"/>
                          </Border>
                          <Border Grid.Column="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                            <TextBlock Text="{Binding Max}" HorizontalAlignment="Center"/>
                          </Border>
                          <Border Grid.Column="4" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                            <TextBlock Text="{Binding Avg}" HorizontalAlignment="Center"/>
                          </Border>
                          <Border Grid.Column="5" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                            <TextBlock Text="{Binding Load}" HorizontalAlignment="Center"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </GroupBox>
              <Border BorderBrush="#6FA0D6" BorderThickness="0,1,0,0" Margin="0,6,0,2"/>
            <GroupBox Header="{Binding OverviewVm.GpuTitle}" Foreground="White" BorderBrush="#6FA0D6" Background="Transparent" Margin="0,6,0,0" Padding="6">
              <StackPanel>
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="46"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="2" Text="Min." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="3" Text="Max." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="4" Text="Avg." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="5" Text="Load" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding OverviewVm.GpuReadings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="74"/>
                          <ColumnDefinition Width="62"/>
                          <ColumnDefinition Width="62"/>
                          <ColumnDefinition Width="62"/>
                          <ColumnDefinition Width="62"/>
                          <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="White" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                          <TextBlock Text="{Binding Value}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                          <TextBlock Text="{Binding Min}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                          <TextBlock Text="{Binding Max}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                          <TextBlock Text="{Binding Avg}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="5" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="1,0" Padding="2,2" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                          <TextBlock Text="{Binding Load}" HorizontalAlignment="Center"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="{Binding OverviewVm.StorageTitle}" Foreground="White" BorderBrush="#6FA0D6" Background="Transparent" Margin="0,6,0,0" Padding="6">
              <ItemsControl ItemsSource="{Binding OverviewVm.DiskRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2,6,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="158"/>
                        <ColumnDefinition Width="50"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="White" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <Border Grid.Column="1" Background="{DynamicResource BoxBrush}" BorderBrush="#333" BorderThickness="1" Margin="2,0" Padding="2,3" TextElement.Foreground="{DynamicResource BoxTextBrush}">
                        <TextBlock Text="{Binding Value}" HorizontalAlignment="Center" FontSize="11"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </GroupBox>
            </StackPanel>

            <!-- Graph -->
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="MiniGraphPanel" Margin="2"/>
              </ScrollViewer>
            </Border>

            <!-- Legend (sections: CPU / GPU / Disks / Network) -->
            <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
              </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}" Padding="10,8">
              <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Text="CPU" FontWeight="Bold" FontSize="12" Margin="0,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                  <CheckBox x:Name="LegendAllCpu" Content="All CPU Cores" FontWeight="SemiBold" Margin="0,2,0,3" Tag="cpu" Click="LegendMaster_Click" Foreground="{DynamicResource TextBrush}"/>
                  <ItemsControl x:Name="OverviewLegendCpu">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" Foreground="{Binding Brush}" IsChecked="{Binding IsVisible}" Margin="0,1" FontSize="11" Click="OverviewLegend_Click"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>                  <Border Height="1" Background="{DynamicResource TextBrush}" Opacity="0.3" Margin="0,10,0,0"/>
                  <TextBlock Text="GPU" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"/>
                  <CheckBox x:Name="LegendAllGpu" Content="All GPU" FontWeight="SemiBold" Margin="0,2,0,3" Tag="gpu" Click="LegendMaster_Click" Foreground="{DynamicResource TextBrush}"/>
                  <ItemsControl x:Name="OverviewLegendGpu">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" Foreground="{Binding Brush}" IsChecked="{Binding IsVisible}" Margin="0,1" FontSize="11" Click="OverviewLegend_Click"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>                  <Border Height="1" Background="{DynamicResource TextBrush}" Opacity="0.3" Margin="0,10,0,0"/>
                  <TextBlock x:Name="SectDisks" Text="Disks" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"/>
                  <CheckBox x:Name="LegendAllDisk" Content="All Disks" FontWeight="SemiBold" Margin="0,2,0,3" Tag="disk" Click="LegendMaster_Click" Foreground="{DynamicResource TextBrush}"/>
                  <ItemsControl x:Name="OverviewLegendDisk">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="3"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" Foreground="{Binding Brush}" IsChecked="{Binding IsVisible}" Margin="0,1" FontSize="11" Click="OverviewLegend_Click"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>                  <Border Height="1" Background="{DynamicResource TextBrush}" Opacity="0.3" Margin="0,10,0,0"/>
                  <TextBlock x:Name="SectNetwork" Text="Network" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"/>
                  <ItemsControl x:Name="OverviewLegendNet">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" Foreground="{Binding Brush}" IsChecked="{Binding IsVisible}" Margin="0,1" FontSize="11" Click="OverviewLegend_Click"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>                </StackPanel>
              </ScrollViewer>
            </Border>
            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}" Padding="12,10">
              <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="QuickClock" Text="--:--:--" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="QuickDate" Text="" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,10"/>
                <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}" Margin="0,2"><Run x:Name="QuickUptimeLabel" Text="Uptime: " FontWeight="SemiBold"/><Run x:Name="QuickUptime" Text="-"/></TextBlock>
                <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}" Margin="0,2"><Run x:Name="QuickIpLabel" Text="IP Address: " FontWeight="SemiBold"/><Run x:Name="QuickIp" Text="-"/></TextBlock>
                <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}" Margin="0,2"><Run x:Name="QuickDownLabel" Text="Download (session): " FontWeight="SemiBold"/><Run x:Name="QuickNetDown" Text="-"/></TextBlock>
                <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}" Margin="0,2"><Run x:Name="QuickUpLabel" Text="Upload (session): " FontWeight="SemiBold"/><Run x:Name="QuickNetUp" Text="-"/></TextBlock>
                <TextBlock x:Name="QuickFanHeader" Text="Fan" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,2"/>
                <ItemsControl x:Name="QuickFans">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RpmText, Mode=OneWay}"/></TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            </Grid>
          </Grid>
        </Border>
      </TabItem>

      <!-- ===== HTOP (Linux htop style) ===== -->
      <TabItem Header="HTOP">
        <TabItem.Resources>
          <DataTemplate x:Key="HtopMeterTemplate">
            <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,1">
              <Run Text="{Binding Label, Mode=OneWay}" Foreground="#9CDCFE"/><Run Text=" ["/><Run Text="{Binding BarFilled, Mode=OneWay}" Foreground="#00E676"/><Run Text="{Binding BarEmpty, Mode=OneWay}"/><Run Text="] "/><Run Text="{Binding Text, Mode=OneWay}"/>
            </TextBlock>
          </DataTemplate>
        </TabItem.Resources>
        <Border Background="#0D1117" TextElement.Foreground="#E6E6E6" TextElement.FontFamily="Consolas">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <ItemsControl ItemsSource="{Binding HtopVm.CpuMetersLeft}" ItemTemplate="{StaticResource HtopMeterTemplate}"/>
                <ContentControl Content="{Binding HtopVm.MemMeter}" ContentTemplate="{StaticResource HtopMeterTemplate}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <ItemsControl ItemsSource="{Binding HtopVm.CpuMetersRight}" ItemTemplate="{StaticResource HtopMeterTemplate}"/>
                <ContentControl Content="{Binding HtopVm.SwpMeter}" ContentTemplate="{StaticResource HtopMeterTemplate}" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding HtopVm.HeaderText}" Margin="0,8,0,4" Foreground="#9CDCFE"/>
            <DataGrid x:Name="HtopGrid" Grid.Row="2" ItemsSource="{Binding HtopVm.Processes}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="#0D1117" Foreground="#E6E6E6" BorderBrush="#2E7D32"
                      RowBackground="#0D1117" AlternatingRowBackground="#11161D"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#263238"
                      FontFamily="Consolas" FontSize="12" RowHeight="19"
                      CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                      HeadersVisibility="Column">
              <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                  <Setter Property="Background" Value="#1B5E20"/>
                  <Setter Property="Foreground" Value="White"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="Padding" Value="4,2"/>
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#2E7D32"/>
                      <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid, Mode=OneWay}" Width="60"/>
                <DataGridTextColumn Header="USER" Binding="{Binding User, Mode=OneWay}" Width="110"/>
                <DataGridTextColumn Header="PRI" Binding="{Binding Pri, Mode=OneWay}" Width="45"/>
                <DataGridTextColumn Header="CPU%" Binding="{Binding CpuPct, StringFormat={}{0:0.0}, Mode=OneWay}" Width="70"/>
                <DataGridTextColumn Header="MEM%" Binding="{Binding MemPct, StringFormat={}{0:0.0}, Mode=OneWay}" Width="70"/>
                <DataGridTextColumn Header="RES" Binding="{Binding ResText, Mode=OneWay}" Width="80"/>
                <DataGridTextColumn Header="THR" Binding="{Binding Threads, Mode=OneWay}" Width="50"/>
                <DataGridTextColumn Header="TIME+" Binding="{Binding TimeText, Mode=OneWay}" Width="90"/>
                <DataGridTextColumn Header="Command" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="3" Margin="0,8,0,0">
              <TextBlock Text="F4 Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="HtopFilterBox" Width="180" Background="#11161D" Foreground="#E6E6E6" BorderBrush="#2E7D32" CaretBrush="#E6E6E6" TextChanged="HtopFilter_TextChanged"/>
              <Button Content="{Binding HtopVm.SortLabel}" Margin="10,0,0,0" Padding="10,3" Background="#1B5E20" Foreground="White" BorderBrush="#2E7D32" Click="HtopSort_Click"/>
              <Button Content="F9 Kill" Margin="8,0,0,0" Padding="10,3" Background="#5E1B1B" Foreground="White" BorderBrush="#7D2E2E" Click="HtopKill_Click"/>
              <TextBlock Text="Pilih proses lalu F9 untuk mematikan - urutan via tombol F6" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8A9A5B"/>
            </DockPanel>
          </Grid>
        </Border>
      </TabItem>

      <!-- ===== CPU (Argus: Temp. / Speed / Mul. / Power) ===== -->
      <TabItem Header="CPU">
        <Border Background="{DynamicResource PageBrush}">
          <DockPanel Margin="10,8,10,10">
            <!-- Sub-navigation -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <ToggleButton x:Name="CpuSubTemp" Content="CPU Temp." Style="{StaticResource ArgusSubTab}"
                            IsChecked="True" Click="CpuSubTab_Click"/>
              <ToggleButton x:Name="CpuSubSpeed" Content="CPU Speed" Style="{StaticResource ArgusSubTab}"
                            Click="CpuSubTab_Click"/>
              <ToggleButton x:Name="CpuSubMul" Content="CPU Mul." Style="{StaticResource ArgusSubTab}"
                            Click="CpuSubTab_Click"/>
              <ToggleButton x:Name="CpuSubPower" Content="CPU Power" Style="{StaticResource ArgusSubTab}"
                            Click="CpuSubTab_Click"/>
            </StackPanel>

            <Grid>
              <!-- CPU Temp. live view -->
              <Grid x:Name="CpuTempView">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="CpuMiniPanel" Margin="2"/></ScrollViewer>
                </Border>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}" Padding="12,10" MinWidth="160">
                    <ItemsControl x:Name="CpuTempLegend">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" Margin="0,2" FontSize="13"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="GraphVendor" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GraphModel" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Grid>

              <!-- Placeholder sub-views (Speed / Mul. / Power) -->
              <Border x:Name="CpuPlaceholderView" Visibility="Collapsed" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
                <TextBlock x:Name="CpuPlaceholderText"
                           Text="Coming soon"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="#555"/>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </TabItem>

      <!-- ===== GPU (Argus style) ===== -->
      <TabItem Header="GPU">
        <Border Background="{DynamicResource PageBrush}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- Graph -->
            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="GpuMiniPanel" Margin="2"/></ScrollViewer>
            </Border>

            <!-- Right live stats -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0">
              <TextBlock Text="{Binding GpuVm.GpuTempLine, Mode=OneWay}" FontWeight="Bold" Margin="0,2" Foreground="#111"/>
              <TextBlock Text="{Binding GpuVm.HotSpotLine, Mode=OneWay}" Margin="0,2" Foreground="#111"/>
              <TextBlock Text="{Binding GpuVm.LoadLine, Mode=OneWay}" Margin="0,2" Foreground="#111"/>
              <TextBlock Text="{Binding GpuVm.CoreClockLine, Mode=OneWay}" Margin="0,2" Foreground="#111"/>
              <TextBlock Text="{Binding GpuVm.MemoryClockLine, Mode=OneWay}" Margin="0,2" Foreground="#111"/>
              <TextBlock Text="{Binding GpuVm.FanSpeedLine, Mode=OneWay}" Margin="0,2" Foreground="#111"/>
              <ComboBox x:Name="GpuFanMode" Margin="0,10,0,0" Width="160" HorizontalAlignment="Left"
                        SelectedIndex="0">
                <ComboBoxItem Content="BIOS Controlled"/>
                <ComboBoxItem Content="Software Controlled"/>
              </ComboBox>
              <Button x:Name="GpuCurveButton" Content="Curve..." Margin="0,8,0,0" Width="160" HorizontalAlignment="Left" Click="GpuCurve_Click"/>
            </StackPanel>

            <!-- Bottom: legend + GPU info -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>



              <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="4,4,0,0">
                <TextBlock Text="{Binding GpuVm.GpuName, Mode=OneWay}" Foreground="#111" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding GpuVm.HelpText, Mode=OneWay}"
                           Visibility="{Binding GpuVm.HelpVisibility, Mode=OneWay}"
                           Foreground="#228B22" FontSize="12" Margin="0,0,0,10"/>
                <CheckBox x:Name="GpuApplyStartup" Content="Apply last settings at startup"
                          Foreground="#111"
                          Checked="GpuApplyStartup_Changed" Unchecked="GpuApplyStartup_Changed"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </TabItem>

      <!-- ===== HD Temp. (Argus style) ===== -->
      <TabItem Header="HD Temp.">
        <Border Background="{DynamicResource PageBrush}">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="HdMiniPanel" Margin="2"/></ScrollViewer>
            </Border>


          </Grid>
        </Border>
      </TabItem>

      <!-- ===== S.M.A.R.T. (Argus style) ===== -->
      <TabItem Header="S.M.A.R.T.">
        <Border Background="{DynamicResource PageBrush}">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Attribute table -->
            <DataGrid x:Name="SmartAttributeGrid"
                      ItemsSource="{Binding SmartVm.Attributes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="{DynamicResource AltRowBrush}"
                      RowBackground="{DynamicResource BoxBrush}"
                      Background="{DynamicResource BoxBrush}"
                      BorderBrush="#333"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FontSize="12">
              <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D0E4F8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E8F0F8"/>
              </DataGrid.Resources>
              <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                  <Setter Property="Background" Value="#1B3A6E"/>
                  <Setter Property="Foreground" Value="White"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Padding" Value="8,5"/>
                  <Setter Property="BorderBrush" Value="#4A6FA5"/>
                  <Setter Property="BorderThickness" Value="0,0,1,1"/>
                  <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                  <Setter Property="Padding" Value="6,3"/>
                  <Setter Property="BorderBrush" Value="#DDD"/>
                  <Setter Property="BorderThickness" Value="0,0,1,1"/>
                  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                          <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </DataGrid.CellStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="44"/>
                <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="*"/>
                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="140"/>
                <DataGridTemplateColumn Header="Status" Width="70">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Status}"
                                 Foreground="{Binding StatusBrush}"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <!-- Drive sidebar -->
            <DockPanel Grid.Column="2" LastChildFill="False">
              <ComboBox DockPanel.Dock="Top"
                        ItemsSource="{Binding SmartVm.Drives}"
                        SelectedItem="{Binding SmartVm.SelectedDrive, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        Height="26"
                        Margin="0,0,0,12"/>

              <StackPanel DockPanel.Dock="Top" Margin="2,0,0,0">
                <TextBlock Text="{Binding SmartVm.SelectedDrive.DriveType}" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding SmartVm.SelectedDrive.Model}" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Foreground="White" Margin="0,2">
                  <Run Text="Size: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.SizeText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="White" Margin="0,2">
                  <Run Text="Interface: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.Interface, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="White" Margin="0,2">
                  <Run Text="Temperature: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.TemperatureText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="White" Margin="0,2">
                  <Run Text="Uptime: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.UptimeText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="White" Margin="0,2">
                  <Run Text="Serial: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.Serial, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="White" Margin="0,2">
                  <Run Text="Firmware: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.Firmware, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="White" Margin="0,2,0,14">
                  <Run Text="Buffer: " FontWeight="Bold"/><Run Text="{Binding SmartVm.SelectedDrive.Buffer, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Text="{Binding SmartVm.SelectedDrive.FreeSpaceText}" Foreground="White" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ProgressBar Height="16"
                               Minimum="0" Maximum="100"
                               Value="{Binding SmartVm.SelectedDrive.UsedPercent, Mode=OneWay}"
                               Foreground="#3A4A5A"
                               Background="{DynamicResource BoxBrush}"
                               BorderBrush="#333"
                               BorderThickness="1"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SmartVm.SelectedDrive.UsedPercentText}"
                             Foreground="White" FontWeight="Bold"
                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </TabItem>

      <!-- ===== Mainboard (Argus: Temperature / Fan Speed / Fan Control) ===== -->
      <TabItem Header="Mainboard">
        <Border Background="{DynamicResource PageBrush}">
          <DockPanel Margin="10,8,10,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <ToggleButton x:Name="MbSubTemp" Content="Temperature" Style="{StaticResource ArgusSubTab}"
                            IsChecked="True" Click="MainboardSubTab_Click"/>
              <ToggleButton x:Name="MbSubFanSpeed" Content="Fan Speed" Style="{StaticResource ArgusSubTab}"
                            Click="MainboardSubTab_Click"/>
              <ToggleButton x:Name="MbSubFanControl" Content="Fan Control" Style="{StaticResource ArgusSubTab}"
                            Click="MainboardSubTab_Click"/>
            </StackPanel>

            <!-- Temperature (live Argus view) -->
            <Grid x:Name="MbTempView">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="MbMiniPanel" Margin="2"/></ScrollViewer>
              </Border>

              <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding MainboardVm.BoardName, Mode=OneWay}"
                             Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding MainboardVm.ChipLine, Mode=OneWay}"
                             Foreground="White" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- Fan Speed (live RPM list) -->
            <Border x:Name="MbFanSpeedView" Visibility="Collapsed"
                    BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}" Padding="16,12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Motherboard fan RPM"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl x:Name="MainboardFanList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding RpmText}" FontSize="13" FontWeight="SemiBold"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>

            <!-- Fan Control sub-tab: pointer to standalone Fan Control tab (do not delete engine) -->
            <Border x:Name="MbFanControlView" Visibility="Collapsed"
                    BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}" Padding="24">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Fan curves and PWM live on the main Fan Control tab."
                           FontSize="14" Foreground="#333" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="420"/>
                <TextBlock Text="Open the Fan Control tab to adjust channels, curves, and manual PWM."
                           FontSize="12" Foreground="#666" TextAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap" MaxWidth="420"/>
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>
      </TabItem>

      <!-- ===== System (Argus: CPU Usage / RAM / Network / Disk I/O / Synth. Temp.) ===== -->
      <TabItem Header="System">
        <Border Background="{DynamicResource PageBrush}">
          <DockPanel Margin="10,8,10,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <ToggleButton x:Name="SysSubCpu" Content="CPU Usage" Style="{StaticResource ArgusSubTab}"
                            IsChecked="True" Click="SystemSubTab_Click"/>
              <ToggleButton x:Name="SysSubRam" Content="RAM" Style="{StaticResource ArgusSubTab}"
                            Click="SystemSubTab_Click"/>
              <ToggleButton x:Name="SysSubNet" Content="Network" Style="{StaticResource ArgusSubTab}"
                            Click="SystemSubTab_Click"/>
              <ToggleButton x:Name="SysSubDisk" Content="Disk I/O" Style="{StaticResource ArgusSubTab}"
                            Click="SystemSubTab_Click"/>
              <ToggleButton x:Name="SysSubSynth" Content="Synth. Temp." Style="{StaticResource ArgusSubTab}"
                            Click="SystemSubTab_Click"/>
            </StackPanel>

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}">
                <ctrl:SystemGraphCanvas x:Name="SystemGraph" Margin="2"/>
              </Border>

              <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource BoxBrush}"
                      Margin="0,10,0,0" Padding="12,10" HorizontalAlignment="Left" MinWidth="200">
                <TextBlock x:Name="SystemValueLabel"
                           Text="{Binding SystemVm.ValueLabel, Mode=OneWay}"
                           Foreground="#B22222" FontSize="13" FontWeight="SemiBold"/>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </TabItem>

      <!-- ===== Fan Control (no scroll) ===== -->
      <TabItem Header="Fan Control">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <GroupBox x:Name="FanTempsGroup" Header="Temps" Grid.Column="0" Padding="6">
            <ItemsControl x:Name="TempList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" FontWeight="SemiBold" FontSize="11"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>

          <GroupBox Header="Fan Control" Grid.Column="2" Padding="4">
            <DockPanel>
              <CheckBox x:Name="ApplyStartupGlobal" DockPanel.Dock="Top" Content="Apply on startup"
                        Margin="0,0,0,4"
                        Checked="ApplyStartupGlobal_Changed" Unchecked="ApplyStartupGlobal_Changed"/>
              <ItemsControl x:Name="FanList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,3" Margin="0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="88"/>
                          <ColumnDefinition Width="70"/>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="88"/>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Column="0" FontSize="11" Padding="2"
                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding RpmText}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding OutputText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" FontSize="11" Height="22" SelectedItem="{Binding Mode}"
                                  ItemsSource="{Binding ModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectionChanged="FanMode_Changed" Margin="2,0"/>
                        <ComboBox Grid.Column="4" FontSize="11" Height="22" SelectedItem="{Binding Source}"
                                  ItemsSource="{Binding SourceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectionChanged="FanSource_Changed" Margin="2,0"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="Curve" FontSize="10" Padding="6,1" Click="Curve_Click" Tag="{Binding}" Margin="2,0"/>
                          <Button Content="Multi" FontSize="10" Padding="6,1" Click="Multi_Click" Tag="{Binding}" Margin="2,0"/>
                          <Button Content="Adv" FontSize="10" Padding="6,1" Click="Advanced_Click" Tag="{Binding}" Margin="2,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="6" Content="Start" FontSize="10" IsChecked="{Binding ApplyOnStartup}"
                                  VerticalAlignment="Center"
                                  Checked="FanApplyStartup_Changed" Unchecked="FanApplyStartup_Changed"/>

                        <DockPanel Grid.Row="1" Grid.ColumnSpan="7" Margin="0,2,0,0">
                          <TextBlock Text="Manual" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <Button DockPanel.Dock="Right" Content="OK" FontSize="10" Padding="8,1"
                                  Click="ManualApply_Click" Tag="{Binding}" Margin="6,0,0,0"/>
                          <Slider Minimum="0" Maximum="100" Height="18"
                                  Value="{Binding ManualPwm, Mode=TwoWay}"/>
                        </DockPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </GroupBox>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
