    public MainWindow()
    {
        InitializeComponent();
        DataContext = this;
        _service = App.Service;
        _warnings = new WarningMonitor(Dispatcher);

        TempList.ItemsSource = _service.Temperatures;
        FanList.ItemsSource = _service.Fans;
        CpuTempLegend.ItemsSource = _graph.Legend;
        // CPU mini graphs sync per tick (OCCT style).
        _activeCpuGraph = _graph;
        GpuFanMode.SelectionChanged += GpuFanMode_Changed;
        OverviewLegendCpu.ItemsSource = _legendCpu;
        OverviewLegendGpu.ItemsSource = _legendGpu;
        OverviewLegendDisk.ItemsSource = _legendDisk;
        OverviewLegendNet.ItemsSource = _legendNet;
        // Overview mini graphs (OCCT style) are created and synced per tick.
        // GPU legend replaced by mini graph tiles.
        // GPU mini graphs sync per tick.
        // HD legend replaced by mini graph tiles.
        // HD mini graphs sync per tick.
        // Mainboard legend replaced by mini graph tiles.
        MainboardFanList.ItemsSource = _service.Mainboard.Fans;
        QuickFans.ItemsSource = _service.Mainboard.Fans;
        // Mainboard mini graphs sync per tick.
        SystemGraph.Bind(_service.SystemVm);

        ApplyStartupGlobal.IsChecked = _service.Profile.ApplyOnStartupGlobal;
        MenuApplyStartup.IsChecked = _service.Profile.ApplyOnStartupGlobal;
        MenuLogging.IsChecked = _service.Profile.Logging.Enabled;
        GpuApplyStartup.IsChecked = _service.Profile.ApplyOnStartupGlobal;

        UpdateBanner();
        ApplyLocalization();
        LocalizationService.Instance.LanguageChanged += () => Dispatcher.BeginInvoke(ApplyLocalization);
        InitTray();
        ThemeService.LoadSaved();
        ThemeService.ApplyTo(this);
        ThemeSelector.SelectedIndex = ThemeService.IsDark ? 1 : 0;
        _themeReady = true;
        RefreshAllUi();
        OnPropertyChanged(nameof(CpuInfo));

        _uiTimer = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(1000) };
        _uiTimer.Tick += (_, _) => RefreshAllUi();
        _uiTimer.Start();

        _service.UiTick += () => Dispatcher.BeginInvoke(RefreshAllUi);
    }

    private void RefreshAllUi()
    {
        try
        {
            _service.ApplyCpuToUi();
            _service.ApplyOverviewToUi();
            _service.ApplyGpuToUi();
            if (!_gpuFanUiInit && _service.IsHardwareOpen)
            {
                _gpuFanUiInit = true;
                GpuFanMode.SelectedIndex = _service.Profile.GpuFan.SoftwareControl ? 1 : 0;
            }
            _service.ApplyGpuFanControl();
            _service.ApplyHdTempToUi();
            _service.ApplySmartToUi();
            _service.ApplyMainboardToUi();
            _service.ApplySystemToUi();
            if (MainTabs.SelectedIndex == 1)
                HtopVm.Refresh();
            UpdateGraphFromCpu();
            SyncMiniGraphs();
            UpdateLegendMasters();
        SyncLegendSections();
        UpdateQuickInfo();
            SyncGpuMiniGraphs();
            SyncHdMiniGraphs();
            SyncMbMiniGraphs();
            SystemGraph.Redraw();
            RefreshStatus();
            _warnings.Tick(ResolveCpuWarningTemp());
            _warnings.TickGpu(ResolveGpuWarningTemp());
            _warnings.TickDrives(ResolveDriveWarningTemp());
            _warnings.TickFans(CollectFanStates());
            _warnings.TickCpuCores(ResolveCoreWarningTemp());
            _warnings.TickMainboard(ResolveMainboardWarningTemp());
            UpdateTrayTemp();
            _compact?.RefreshData();
        }
        catch (Exception ex)
        {
            StatusText.Text = "Error: " + ex.Message;
            StatusText.Foreground = System.Windows.Media.Brushes.OrangeRed;
        }
    }

    private void HtopSort_Click(object sender, System.Windows.RoutedEventArgs e)
    {
        HtopVm.SortByCpu = !HtopVm.SortByCpu;
        HtopVm.Refresh();
    }

    private void HtopKill_Click(object sender, System.Windows.RoutedEventArgs e)
    {
        if (HtopGrid.SelectedItem is not HtopProcessRow row)
            return;
        if (row.Pid <= 4 || row.Pid == Environment.ProcessId)
        {
            System.Windows.MessageBox.Show("Proses ini tidak boleh dimatikan.", "HTOP",
                System.Windows.MessageBoxButton.OK, System.Windows.MessageBoxImage.Warning);
            return;
        }
        if (System.Windows.MessageBox.Show($"Matikan proses {row.Name} (PID {row.Pid})?",
                "HTOP", System.Windows.MessageBoxButton.YesNo,
                System.Windows.MessageBoxImage.Warning) != System.Windows.MessageBoxResult.Yes)
            return;
        try
        {
            System.Diagnostics.Process.GetProcessById(row.Pid).Kill();
        }
        catch (Exception ex)
        {
            System.Windows.MessageBox.Show("Gagal mematikan proses: " + ex.Message, "HTOP",
                System.Windows.MessageBoxButton.OK, System.Windows.MessageBoxImage.Error);
        }
        HtopVm.Refresh();
    }

