    private void SetMasterState(CheckBox box, string group)
    {
        int total = 0, visible = 0;
        foreach (var item in _service.Overview.Legend)
        {
            if (OverviewViewModel.GroupOf(item.Name) != group)
                continue;
            total++;
            if (item.IsVisible)
                visible++;
        }

        if (total == 0 || visible == 0)
            box.IsChecked = false;
        else if (visible == total)
            box.IsChecked = true;
        else
            box.IsChecked = null;
    }

