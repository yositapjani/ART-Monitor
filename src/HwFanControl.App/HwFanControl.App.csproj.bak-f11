<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HwFanControl.Core\HwFanControl.Core.csproj" />
    <ProjectReference Include="..\HwFanControl.Hardware\HwFanControl.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="art-version.txt" />
    <None Include="sync-version.ps1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>HwFanControl.App</RootNamespace>
    <AssemblyName>ART-Monitor</AssemblyName>
    <Product>ART-Monitor</Product>
    <AssemblyTitle>ART-Monitor</AssemblyTitle>
    <Company>ART-Monitor</Company>
    <Description>ART-Monitor — hardware monitor and fan control</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
  </PropertyGroup>

  <Target Name="PrepareArtMonitorVersion" BeforeTargets="GenerateAssemblyInfo;CoreGenerateAssemblyInfo;GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\sync-version.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -Mode prepare" />
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\art-display.txt">
      <Output TaskParameter="Lines" PropertyName="InformationalVersion" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\art-assembly.txt">
      <Output TaskParameter="Lines" PropertyName="AssemblyVersion" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\art-assembly.txt">
      <Output TaskParameter="Lines" PropertyName="FileVersion" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\art-semver.txt">
      <Output TaskParameter="Lines" PropertyName="Version" />
    </ReadLinesFromFile>
    <Message Importance="high" Text="Packaging ART-Monitor $(InformationalVersion)" />
  </Target>

  <Target Name="BumpArtMonitorVersion" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\sync-version.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -Mode bump" />
  </Target>

  <!-- Flatten RID-specific LHM next to the exe so publish folders always load sensors -->
  <Target Name="CopyLibreHardwareMonitorBesideApp" AfterTargets="Build;Publish">
    <ItemGroup>
      <_LhmCandidates Include="$(OutputPath)runtimes\win-x64\lib\net8.0\LibreHardwareMonitorLib.dll" />
      <_LhmCandidates Include="$(PublishDir)runtimes\win-x64\lib\net8.0\LibreHardwareMonitorLib.dll" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_LhmCandidates)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(_LhmCandidates.Identity)')" />
    <Copy SourceFiles="@(_LhmCandidates)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('%(_LhmCandidates.Identity)')" />
  </Target>

</Project>
