<Application x:Class="HwFanControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             Exit="Application_Exit">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#ABADB3"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#555555"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0066CC"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#856404"/>
  </Application.Resources>
</Application>
